{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    // 束ねるスクリプトの import (tools/bundle.mjs の BUNDLES) を esbuild と同じく package の exports で引く。
    // @mediapipe/tasks-vision 0.10.35 の exports は "types" を最後に置くが、TS 6 はそれでも vision.d.ts を引く
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["scripts/*.ts", "examples/*.ts", "types/host.d.ts", "types/authoring.d.ts"]
}
